# Porashona Backend — Environment Variables
# Copy to .env and fill in your values

# ─── Server ─────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:8081

# ─── Supabase ────────────────────────────────────────────
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# ─── AI Provider Configuration ────────────────────────────
# AI_PROVIDER: "together" | "ollama" (default: together)
AI_PROVIDER=together
AI_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo

# ─── Together AI ─────────────────────────────────────────
TOGETHER_API_KEY=your_together_api_key

# ─── Ollama (Local LLM) ──────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# AI_CACHE_TTL=300000

# ─── Anthropic Claude ────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5

# ─── SSLCommerz (Payments) ───────────────────────────────
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false
PAYMENT_SUCCESS_URL=http://localhost:3001/payment/success
PAYMENT_FAIL_URL=http://localhost:3001/payment/fail
PAYMENT_CANCEL_URL=http://localhost:3001/payment/cancel

# ─── Twilio WhatsApp ─────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@porashona.com

# ─── Bunny.net Video ─────────────────────────────────────
BUNNY_API_KEY=your_bunny_key
BUNNY_LIBRARY_ID=your_library_id
BUNNY_CDN_HOSTNAME=your_hostname.b-cdn.net

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
